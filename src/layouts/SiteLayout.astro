---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false
} = Astro.props;

const site = 'https://pairpilotfx.com';
const canonical = new URL(canonicalPath, site).toString();
const pageTitle = title === 'PairPilotFX'
  ? 'PairPilotFX — Guiding Better Trading Decisions'
  : `${title} — PairPilotFX`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06101d" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/pairpilotfx-compass.png" type="image/png" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/pairpilotfx-compass.png" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PairPilotFX" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://pairpilotfx.com/brand/pairpilotfx-banner.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="820" />
    <meta property="og:image:height" content="312" />
    <meta property="og:image:alt" content="PairPilot FX — Guiding Better Trading Decisions" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pairpilotfx.com/brand/pairpilotfx-banner.png" />
    <meta name="twitter:image:alt" content="PairPilot FX — Guiding Better Trading Decisions" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'PairPilotFX',
      url: site,
      slogan: 'Guiding Better Trading Decisions',
      email: 'pairpilotfx@gmail.com'
    })} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initAnalytics } from '../scripts/analytics';
      initAnalytics();
    </script>
  </body>
</html>
