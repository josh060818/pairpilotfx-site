---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Radar Waitlist Received"
  description="Your PairPilot Radar early-access waitlist submission has been received."
  canonicalPath="/early-access/thanks/"
>
  <section class="thanks">
    <div class="container">
      <div class="thanks-card card">
        <span class="success-mark" aria-hidden="true">✓</span>
        <p class="eyebrow">PairPilot Radar</p>
        <h1>Waitlist submission received.</h1>
        <p class="lead">
          PairPilotFX will use the early-access list when selecting a small group of testers for the next
          product phase. Joining does not guarantee an invitation.
        </p>
        <div class="button-row">
          <a
            class="button"
            href="/weekly/"
            data-analytics-event="weekly_brief_cta_click"
            data-analytics-placement="early_access_thanks"
          >Follow the Weekly FX Brief →</a>
          <a class="button button-secondary" href="/radar/">Back to Radar</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    if (params.get('submitted') === '1') {
      window.addEventListener('load', () => {
        const api = (window as Window & {
          pairpilotfxAnalytics?: {
            track?: (name: string, properties?: Record<string, string | number | boolean | null>) => void
          }
        }).pairpilotfxAnalytics;

        api?.track?.('early_access_signup', {
          product: 'pairpilot_radar',
          provider: 'formsubmit',
          submission_method: 'form_redirect'
        });
      }, { once: true });
    }
  </script>
</SiteLayout>

<style>
  .thanks { padding: 112px 0 100px; }
  .thanks-card {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 64px);
    display: grid;
    gap: 20px;
    border-color: var(--border-strong);
  }
  .thanks-card h1 { font-size: clamp(2.8rem, 7vw, 5rem); }
  .success-mark {
    display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: rgba(126,226,184,.10); border: 1px solid rgba(126,226,184,.35); color: #7ee2b8;
    font-size: 1.4rem; font-weight: 900;
  }
</style>
