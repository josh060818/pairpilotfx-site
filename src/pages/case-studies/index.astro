---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  caseStudyCategoryLabel,
  pairLabel,
  publishedCaseStudies
} from '../../data/case-studies';

const studies = [...publishedCaseStudies].sort((left, right) =>
  right.weekEnd.localeCompare(left.weekEnd)
);
---

<SiteLayout
  title="Market Case Studies"
  description="PairPilotFX Market Case Studies reconstruct what the framework knew at the time, what changed, what price did afterward, and what the process learned — including failures and filtered opportunities."
  canonicalPath="/case-studies/"
>
  <section class="case-hero">
    <div class="container hero-grid">
      <div>
        <div class="pill">Evidence over hindsight</div>
        <p class="eyebrow">PairPilotFX Market Case Studies</p>
        <h1>Review the process, not just the outcome.</h1>
        <p class="lead">
          Each case study starts with the evidence PairPilotFX actually had at the time,
          then separates that point-in-time view from what happened afterward.
          Confirmations, invalidations, filtered pairs, missed movement, and limitations stay visible.
        </p>
        <div class="principles">
          <span>Point-in-time evidence</span>
          <span>Deterministic outcome review</span>
          <span>Human-approved publication</span>
        </div>
      </div>

      <aside class="card method-card">
        <p class="eyebrow">Review sequence</p>
        <ol>
          <li><strong>Context</strong><span>What did the system know?</span></li>
          <li><strong>Selection</strong><span>Why was the pair included or filtered?</span></li>
          <li><strong>Lifecycle</strong><span>What changed during the week?</span></li>
          <li><strong>Outcome</strong><span>What did price do afterward?</span></li>
          <li><strong>Lesson</strong><span>What should the process retain or improve?</span></li>
        </ol>
      </aside>
    </div>
  </section>

  <div class="container"><div class="rule"></div></div>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Published research</p>
          <h2>Case studies without cherry-picking.</h2>
        </div>
        <p class="muted">
          A useful research library includes clean confirmations, invalidations, no-confirmation cases,
          correctly filtered markets, and situations where a filtered pair still moved.
        </p>
      </div>

      {studies.length > 0 ? (
        <div class="study-grid">
          {studies.map((study) => (
            <article class="card study-card">
              <div class="study-meta">
                <span>{pairLabel(study.pair)}</span>
                <span>{study.weekStart} → {study.weekEnd}</span>
              </div>
              <span class="category">{caseStudyCategoryLabel(study.category)}</span>
              <h3>{study.title}</h3>
              <p>{study.summary}</p>
              <a
                class="text-link"
                href={`/case-studies/${study.slug}/`}
                data-analytics-event="case_study_open"
                data-analytics-placement="case_study_index"
              >
                Read the full case study <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="card empty-state">
          <p class="eyebrow">Library opening soon</p>
          <h3>No case study has completed human review and publication yet.</h3>
          <p>
            PairPilotFX does not publish synthetic examples to make the library look populated.
            The first entries will appear only after the deterministic evidence, narrative, and limitations
            have been reviewed against the historical record.
          </p>
          <a
            class="button button-secondary"
            href="/weekly/"
            data-analytics-event="case_study_weekly_cta_click"
            data-analytics-placement="case_study_empty"
          >
            Explore the Weekly FX Brief
          </a>
        </div>
      )}
    </div>
  </section>

  <section class="section-tight">
    <div class="container methodology card">
      <div>
        <p class="eyebrow">Methodology</p>
        <h2>The outcome never rewrites the starting thesis.</h2>
      </div>
      <div>
        <p>
          PairPilotFX preserves the original Radar and weekly-universe evidence first.
          Subsequent H1 price data is evaluated in a separate outcome layer.
          This allows a case study to discuss what followed without pretending that later information
          was available at the original decision point.
        </p>
        <p>
          Scenario-relative favourable and adverse excursion describe price movement around the original
          scenario. They are not trade P&amp;L and do not imply that PairPilotFX entered a position.
        </p>
      </div>
    </div>
  </section>
  <script define:vars={{ publishedCount: studies.length }}>
    window.addEventListener('DOMContentLoaded', () => {
      window.pairpilotfxAnalytics?.track?.('case_study_library_view', {
        published_count: publishedCount
      });
    });
  </script>
</SiteLayout>

<style>
  .case-hero { padding: 92px 0 70px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr);
    gap: 54px;
    align-items: center;
  }
  .hero-grid h1 { max-width: 760px; margin: 12px 0 20px; }
  .principles { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 26px; }
  .principles span, .category {
    border: 1px solid rgba(111,211,255,.22);
    background: rgba(48,157,211,.08);
    color: #b9e8ff;
    border-radius: 999px;
    padding: 7px 10px;
    font-size: .78rem;
    font-weight: 750;
  }
  .method-card { padding: 26px; }
  .method-card ol { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 13px; }
  .method-card li { display: grid; grid-template-columns: 105px 1fr; gap: 12px; }
  .method-card strong { color: white; }
  .method-card span { color: #8fa8bf; }
  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(300px, .7fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 30px;
  }
  .study-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px; }
  .study-card { padding: 25px; }
  .study-meta { display: flex; justify-content: space-between; gap: 12px; color: #7890a8; font-size: .76rem; }
  .study-card .category { display: inline-flex; margin: 20px 0 4px; }
  .study-card h3 { margin: 13px 0 10px; }
  .study-card p { color: #9db0c3; }
  .text-link { color: var(--accent-strong); text-decoration: none; font-weight: 750; }
  .text-link:hover { text-decoration: underline; }
  .empty-state { padding: 34px; max-width: 820px; }
  .empty-state h3 { margin: 8px 0 12px; }
  .empty-state p { color: #9db0c3; max-width: 700px; }
  .empty-state .button { margin-top: 12px; }
  .methodology {
    padding: 30px;
    display: grid;
    grid-template-columns: .75fr 1.25fr;
    gap: 38px;
  }
  .methodology p { color: #9db0c3; }
  @media (max-width: 860px) {
    .hero-grid, .section-heading, .methodology { grid-template-columns: 1fr; }
    .study-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .case-hero { padding-top: 72px; }
    .method-card li { grid-template-columns: 1fr; gap: 3px; }
    .study-meta { flex-direction: column; }
  }
</style>
