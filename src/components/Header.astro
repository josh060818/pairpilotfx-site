---
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="PairPilotFX home">
      <span class="brand-mark-shell" aria-hidden="true"><img class="brand-mark" src="/brand/pairpilotfx-compass.png" width="44" height="44" alt="" /></span>
      <span>PairPilot<span class="brand-accent">FX</span></span>
    </a>

    <nav class="nav-links" aria-label="Primary navigation">
      <a class:list={[{ active: isActive('/') }]} href="/">Home</a>
      <a class:list={[{ active: isActive('/about/') }]} href="/about/">Methodology</a>
      <a href="https://pairpilotfx.substack.com/subscribe" rel="noopener noreferrer">Weekly Brief</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(6,16,29,.84);
    backdrop-filter: blur(16px);
  }
  .nav {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-weight: 850;
    letter-spacing: -.025em;
    text-decoration: none;
    font-size: 1.08rem;
  }
  .brand-accent { color: var(--accent-strong); }
  .brand-mark-shell {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 50%;
    background: #ffffff;
    box-shadow:
      0 0 0 1px rgba(255,255,255,.18),
      0 4px 14px rgba(0,0,0,.22);
  }
  .brand-mark {
    width: 44px;
    height: 44px;
    max-width: none;
    object-fit: contain;
    transform: scale(1.28);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-links a {
    padding: 8px 11px;
    border-radius: 999px;
    color: #aebfd1;
    text-decoration: none;
    font-size: .91rem;
    font-weight: 650;
  }
  .nav-links a:hover, .nav-links a.active {
    color: white;
    background: rgba(255,255,255,.06);
  }
  @media (max-width: 620px) {
    .nav { min-height: 62px; }
    .nav-links a:first-child { display: none; }
    .nav-links { gap: 2px; }
    .nav-links a { padding-inline: 8px; font-size: .84rem; }
  }
</style>
