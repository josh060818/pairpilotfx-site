---
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="PairPilotFX home">
      <span>PairPilot<span class="brand-accent">FX</span></span>
    </a>

    <nav class="nav-links" aria-label="Primary navigation">
      <a class:list={[{ active: isActive('/') }]} href="/">Home</a>
      <a class:list={[{ active: isActive('/about/') }]} href="/about/">Methodology</a>
      <a
        class:list={[{ active: isActive('/weekly/') }]}
        href="/weekly/"
        data-analytics-event="weekly_brief_cta_click"
        data-analytics-placement="header"
      >Weekly Brief</a>
      <a
        class:list={[{ active: isActive('/tools/') }]}
        href="/tools/"
        data-analytics-event="free_tool_cta_click"
        data-analytics-placement="header"
      >Tools</a>
      <a
        class:list={[{ active: isActive('/radar/') }]}
        href="/radar/"
        data-analytics-event="radar_cta_click"
        data-analytics-placement="header"
      >Radar</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(6,16,29,.84);
    backdrop-filter: blur(16px);
  }
  .nav {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-weight: 850;
    letter-spacing: -.025em;
    text-decoration: none;
    font-size: 1.08rem;
  }
  .brand-accent { color: var(--accent-strong); }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-links a {
    padding: 8px 11px;
    border-radius: 999px;
    color: #aebfd1;
    text-decoration: none;
    font-size: .91rem;
    font-weight: 650;
  }
  .nav-links a:hover, .nav-links a.active {
    color: white;
    background: rgba(255,255,255,.06);
  }
  @media (max-width: 620px) {
    .nav { min-height: 62px; gap: 12px; }
    .nav-links a:first-child,
    .nav-links a[href="/about/"] { display: none; }
    .nav-links { gap: 2px; }
    .nav-links a { padding-inline: 7px; font-size: .8rem; }
    .brand { font-size: 1rem; }
  }
</style>
