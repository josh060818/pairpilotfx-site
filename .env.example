# Google Analytics 4 web stream. Leave empty to keep GA4 disabled.
PUBLIC_GA_MEASUREMENT_ID=

# Privacy default. true = external analytics waits for an explicit visitor choice.
PUBLIC_ANALYTICS_CONSENT_REQUIRED=true

# Optional first-party analytics collector.
# Leave empty to keep events browser-local/dataLayer-only.
PUBLIC_ANALYTICS_ENDPOINT=

# Set to true only for local/browser debugging.
PUBLIC_ANALYTICS_DEBUG=false

# Optional override for the public Radar early-access form transport.
# The production site currently falls back to FormSubmit if this is empty.
PUBLIC_WAITLIST_ENDPOINT=
